<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         Cards
         Flat, hairline-stroked surfaces. Elevation is 0 because
         shadows on a near-black background read as grey smudges;
         a 1dp stroke separates layers far more cheaply and cleanly.
         ============================================================ -->
    <style name="Widget.FocusLife.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/navy_850</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/navy_700</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="android:layout_marginBottom">@dimen/space_m</item>
    </style>

    <style name="Widget.FocusLife.Card.Accent">
        <item name="strokeColor">@color/accent_700</item>
        <item name="cardBackgroundColor">@color/navy_850</item>
    </style>

    <style name="Widget.FocusLife.Card.Flat">
        <item name="cardBackgroundColor">@color/navy_800</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">@dimen/card_radius_small</item>
    </style>

    <!-- ============================================================
         Buttons
         ============================================================ -->
    <style name="Widget.FocusLife.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_600</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="cornerRadius">@dimen/card_radius_small</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="rippleColor">@color/accent_glow</item>
    </style>

    <style name="Widget.FocusLife.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/navy_750</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="cornerRadius">@dimen/card_radius_small</item>
    </style>

    <style name="Widget.FocusLife.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/navy_600</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="cornerRadius">@dimen/card_radius_small</item>
    </style>

    <style name="Widget.FocusLife.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/accent_500</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.FocusLife.Button.Danger">
        <item name="backgroundTint">@color/danger_soft</item>
        <item name="android:textColor">@color/danger_500</item>
        <item name="strokeColor">@color/danger_500</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
    </style>

    <!-- Big press-and-hold control used to end a mode / emergency unlock. -->
    <style name="Widget.FocusLife.Button.Hold" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/danger_soft</item>
        <item name="android:textColor">@color/danger_500</item>
        <item name="strokeColor">@color/danger_500</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="cornerRadius">32dp</item>
    </style>

    <!-- ============================================================
         Text inputs
         ============================================================ -->
    <style name="Widget.FocusLife.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent_600</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/card_radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/card_radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/card_radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/card_radius_small</item>
        <item name="hintTextColor">@color/accent_500</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>

    <style name="Widget.FocusLife.TextInput.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/navy_750</item>
        <item name="boxCornerRadiusTopStart">@dimen/card_radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/card_radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/card_radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/card_radius_small</item>
    </style>

    <!-- ============================================================
         Selection controls
         ============================================================ -->
    <style name="Widget.FocusLife.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/text_primary</item>
        <item name="trackTint">@color/navy_700</item>
        <item name="trackDecorationTint">@color/transparent</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.FocusLife.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/accent_500</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Widget.FocusLife.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/accent_500</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <!-- ============================================================
         Navigation
         ============================================================ -->
    <style name="Widget.FocusLife.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/navy_950</item>
        <item name="itemIconTint">@color/bottom_nav_tint</item>
        <item name="itemTextColor">@color/bottom_nav_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.FocusLife.BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.FocusLife.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.FocusLife.NavLabel</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">12dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.FocusLife.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_soft</item>
        <item name="android:width">56dp</item>
        <item name="android:height">30dp</item>
        <item name="marginHorizontal">4dp</item>
    </style>

    <style name="TextAppearance.FocusLife.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.FocusLife.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/navy_900</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.FocusLife.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.FocusLife.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ============================================================
         Chips, sliders, progress
         ============================================================ -->
    <style name="Widget.FocusLife.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/navy_700</item>
        <item name="chipStrokeWidth">@dimen/card_stroke</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.FocusLife.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">@color/accent_500</item>
        <item name="trackColorActive">@color/accent_600</item>
        <item name="trackColorInactive">@color/navy_700</item>
        <item name="haloColor">@color/accent_glow</item>
        <item name="labelStyle">@style/Widget.FocusLife.Tooltip</item>
    </style>

    <style name="Widget.FocusLife.Tooltip" parent="Widget.Material3.Tooltip">
        <item name="backgroundTint">@color/navy_800</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.FocusLife.ProgressHorizontal" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_horizontal</item>
        <item name="android:minHeight">8dp</item>
        <item name="android:maxHeight">8dp</item>
    </style>

    <!-- ============================================================
         Dialogs and sheets
         ============================================================ -->
    <style name="ThemeOverlay.FocusLife.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/navy_800</item>
        <item name="android:background">@color/navy_800</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.FocusLife.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.FocusLife.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.FocusLife.Button.Text</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.FocusLife.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.FocusLife.DialogBody</item>
    </style>

    <style name="TextAppearance.FocusLife.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.FocusLife.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="ThemeOverlay.FocusLife.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.FocusLife.BottomSheet</item>
        <item name="android:navigationBarColor">@color/navy_800</item>
    </style>

    <style name="Widget.FocusLife.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/navy_800</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FocusLife.Sheet</item>
    </style>

    <style name="ShapeAppearance.FocusLife.Sheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ============================================================
         Type scale
         ============================================================ -->
    <style name="TextAppearance.FocusLife.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.FocusLife.Timer" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">@dimen/text_timer</item>
        <item name="android:textColor">@color/text_primary</item>
        <!-- Tabular figures stop the timer from jittering as digits change. -->
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:fontFeatureSettings" tools:targetApi="21">tnum</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.FocusLife.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.FocusLife.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <style name="TextAppearance.FocusLife.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.FocusLife.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <!-- Devanagari matras need vertical room or they clip. -->
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="TextAppearance.FocusLife.Body.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FocusLife.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.FocusLife.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.FocusLife.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/accent_500</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ============================================================
         Layout helpers (included as styles so layouts stay terse)
         ============================================================ -->
    <style name="CardTitle">
        <item name="android:textAppearance">@style/TextAppearance.FocusLife.Overline</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="MetricValue">
        <item name="android:textAppearance">@style/TextAppearance.FocusLife.Headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="MetricCaption">
        <item name="android:textAppearance">@style/TextAppearance.FocusLife.Caption</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:background">@color/navy_700</item>
    </style>

    <!-- ============================================================
         Motion — deliberately minimal
         ============================================================ -->
    <style name="Animation.FocusLife.Window" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in_fast</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_fast</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_fast</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out_fast</item>
    </style>

</resources>
