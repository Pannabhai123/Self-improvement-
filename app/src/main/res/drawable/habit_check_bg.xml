<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_600" />
            <stroke android:width="2dp" android:color="@color/accent_500" />
            <size android:width="@dimen/habit_check_size" android:height="@dimen/habit_check_size" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/transparent" />
            <stroke android:width="2dp" android:color="@color/navy_600" />
            <size android:width="@dimen/habit_check_size" android:height="@dimen/habit_check_size" />
        </shape>
    </item>
</selector>
