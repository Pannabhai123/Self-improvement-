<?xml version="1.0" encoding="utf-8"?>
<!--
  Subtle top-lit navy gradient. The accent is at 12% alpha so the header reads
  as depth rather than as a coloured band, which keeps the score number the
  highest-contrast element on screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/navy_900"
        android:endColor="@color/navy_950"
        android:startColor="@color/navy_800"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="28dp"
        android:bottomRightRadius="28dp" />
</shape>
