<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground.

  A focus ring with a single bright arc and a centred check: at 48dp on a home
  screen this still reads as "target achieved" rather than as an undifferentiated
  circle. Drawn as vectors so the icon costs a few hundred bytes instead of five
  PNG densities, which matters for a lightweight APK.

  The artwork sits inside the central 72dp of the 108dp canvas, keeping it clear
  of the safe zone that launchers crop to a circle/squircle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ring track -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.99,26 Z"
        android:strokeColor="#24314F"
        android:strokeWidth="7"
        android:fillColor="#00000000" />

    <!-- Progress arc: ~72% of the ring, drawn clockwise from 12 o'clock -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 30.6,72.4"
        android:strokeColor="#22D3EE"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Inner ring -->
    <path
        android:pathData="M54,38 A16,16 0 1,1 53.99,38 Z"
        android:strokeColor="#1C2743"
        android:strokeWidth="3"
        android:fillColor="#00000000" />

    <!-- Centred check mark -->
    <path
        android:pathData="M47,54.5 L52,59.5 L62,48.5"
        android:strokeColor="#F1F5FB"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
