<?xml version="1.0" encoding="utf-8"?>
<!--
  Backdrop for the block and emergency-unlock screens. Darker and redder at the
  top than the ordinary navy gradient, so the interception reads as a different
  place from the rest of the app without needing a jarring alert colour.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/navy_900"
        android:endColor="@color/navy_900"
        android:startColor="@color/block_overlay"
        android:type="linear" />
</shape>
