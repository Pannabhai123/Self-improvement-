<?xml version="1.0" encoding="utf-8"?>
<!--
  Local device-to-device backup only. Everything included stays on the user's
  own devices via their Google account; Focus Life itself has no network
  permission and never reads this data.
-->
<full-backup-content>
    <include domain="database" path="focuslife.db" />
    <include domain="sharedpref" path="focuslife_prefs.xml" />
    <include domain="sharedpref" path="focuslife_state.xml" />
    <exclude domain="sharedpref" path="focuslife_unlock.xml" />
</full-backup-content>
