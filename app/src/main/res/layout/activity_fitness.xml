<?xml version="1.0" encoding="utf-8"?>
<!--
  Running and fitness.

  The 1600 m goal is optional and off by default in the sense that a run without
  a timed 1600 still counts fully toward the day. Recording a time is an extra,
  never a requirement, because making a run "not count" without a stopwatch is
  how a fitness log gets abandoned.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fitness_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_900"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_xxl"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/screen_padding">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginStart="-16dp"
            android:background="@color/navy_900"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_secondary"
            app:title="@string/title_fitness"
            app:titleTextColor="@color/text_primary" />

        <!-- ============ Today ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusLife.Card.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/fitness_today_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_distance_today"
                        style="@style/MetricValue"
                        android:textSize="@dimen/text_display_small"
                        tools:text="1.6 km" />

                    <TextView
                        android:id="@+id/tv_target_distance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_marginBottom="8dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                        tools:text="Target 1600 m · 24 min" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_distance"
                    style="@style/Widget.FocusLife.ProgressHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/space_m"
                    android:max="100"
                    tools:progress="100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/fitness_duration"
                            android:textAppearance="@style/TextAppearance.FocusLife.Overline" />

                        <TextView
                            android:id="@+id/tv_duration_today"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.FocusLife.Subtitle"
                            tools:text="24 min" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/fitness_pace"
                            android:textAppearance="@style/TextAppearance.FocusLife.Overline" />

                        <TextView
                            android:id="@+id/tv_pace_today"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.FocusLife.Subtitle"
                            tools:text="15:00 /km" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_log_run"
                    style="@style/Widget.FocusLife.Button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/fitness_log_run"
                    android:textSize="@dimen/text_subtitle"
                    app:icon="@drawable/ic_directions_run"
                    app:iconGravity="textStart"
                    app:iconTint="@color/text_on_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Rest day ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusLife.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/fitness_rest_day" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/fitness_rest_day_desc"
                        android:textAppearance="@style/TextAppearance.FocusLife.Caption" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_rest_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:contentDescription="@string/fitness_mark_rest_day"
                    android:minWidth="@dimen/touch_target"
                    android:minHeight="@dimen/touch_target" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 1600 m ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusLife.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/fitness_target_1600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/fitness_target_1600_desc"
                    android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/fitness_best_1600"
                            android:textAppearance="@style/TextAppearance.FocusLife.Overline" />

                        <TextView
                            android:id="@+id/tv_best_1600"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.FocusLife.Subtitle"
                            tools:text="7:42" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/fitness_longest_run"
                            android:textAppearance="@style/TextAppearance.FocusLife.Overline" />

                        <TextView
                            android:id="@+id/tv_longest_run"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.FocusLife.Subtitle"
                            tools:text="5.2 km" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Weekly progress ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusLife.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/fitness_weekly_progress" />

                    <TextView
                        android:id="@+id/tv_week_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                        tools:text="4 days · 9.4 km" />
                </LinearLayout>

                <com.focuslife.app.ui.widget.BarChartView
                    android:id="@+id/chart_week"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height"
                    android:layout_marginTop="@dimen/space_m"
                    app:bcv_highlightLast="true"
                    app:bcv_showValues="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/fitness_chart_unit"
                    android:textAppearance="@style/TextAppearance.FocusLife.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Exercise checklist ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CardTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/fitness_exercise_checklist" />

            <TextView
                android:id="@+id/tv_workout_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                tools:text="3 of 7" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_workouts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:itemCount="7"
            tools:listitem="@layout/item_workout" />

        <!-- ============ Recent runs ============ -->
        <TextView
            style="@style/CardTitle"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/fitness_recent_runs" />

        <!-- A plain container rather than a RecyclerView: at most ten runs are
             shown, and a RecyclerView nested inside a NestedScrollView cannot
             scroll, so it would add recycling overhead and buy nothing. -->
        <LinearLayout
            android:id="@+id/run_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_no_runs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/fitness_no_runs"
            android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

        <!-- ============ Target ============ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_target"
            style="@style/Widget.FocusLife.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:minHeight="@dimen/touch_target"
            android:text="@string/fitness_daily_target" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
