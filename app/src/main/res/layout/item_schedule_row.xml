<?xml version="1.0" encoding="utf-8"?>
<!-- One scheduled blocking window. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FocusLife.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/selectable_row">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/card_padding"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="@dimen/space_m">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_calendar"
            app:tint="@color/accent_500" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_schedule_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.FocusLife.Body"
                tools:text="Night — Sleep Mode" />

            <TextView
                android:id="@+id/tv_schedule_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                tools:text="21:00 – 04:30" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/routine_enabled"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/touch_target" />

        <ImageButton
            android:id="@+id/btn_schedule_delete"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/selectable_row"
            android:contentDescription="@string/action_delete"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_tertiary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
