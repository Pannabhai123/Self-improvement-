<?xml version="1.0" encoding="utf-8"?>
<!-- One permission row in the setup flow. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FocusLife.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_perm_icon"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_notifications"
                app:tint="@color/accent_500" />

            <TextView
                android:id="@+id/tv_perm_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.FocusLife.Body"
                tools:text="Notifications" />

            <ImageView
                android:id="@+id/iv_perm_state"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_radio_unchecked"
                app:tint="@color/text_tertiary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_perm_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:lineSpacingExtra="2dp"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption"
            tools:text="Reminders for your routine, revision and workouts." />

        <!-- States what breaks when this is declined, which is the honest half of
             a permission request that most apps leave out. -->
        <TextView
            android:id="@+id/tv_perm_consequence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption"
            android:textColor="@color/text_tertiary"
            android:visibility="gone"
            tools:text="Without this, reminders will not appear."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_perm"
            style="@style/Widget.FocusLife.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:minHeight="@dimen/touch_target"
            android:text="@string/perm_grant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
