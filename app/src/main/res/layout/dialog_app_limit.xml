<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-app blocking configuration.

  The four mode toggles and the daily limit are on one screen because they answer
  one question — "when may I open this app?" — and splitting them across screens
  would make the answer impossible to see at a glance.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xxl"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/space_xxl"
        android:paddingBottom="@dimen/space_s">

        <!-- ============ Daily limit ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blocker_limit_label"
            android:textAppearance="@style/TextAppearance.FocusLife.Label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/blocker_limit_desc"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_limit_0"
                style="@style/Widget.FocusLife.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/blocker_limit_none" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_limit_15"
                style="@style/Widget.FocusLife.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/limit_15" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_limit_30"
                style="@style/Widget.FocusLife.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/limit_30" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_limit_60"
                style="@style/Widget.FocusLife.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/limit_60" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_limit_custom"
                style="@style/Widget.FocusLife.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/blocker_limit_custom" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/field_custom_limit"
            style="@style/Widget.FocusLife.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/blocker_limit_minutes"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_custom_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ============ Modes ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/blocker_modes_header"
            android:textAppearance="@style/TextAppearance.FocusLife.Label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/blocker_modes_desc"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_focus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:minHeight="@dimen/touch_target"
            android:text="@string/mode_deep_focus"
            android:textAppearance="@style/TextAppearance.FocusLife.Body"
            android:textColor="@color/text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_study"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/mode_study"
            android:textAppearance="@style/TextAppearance.FocusLife.Body"
            android:textColor="@color/text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/mode_run"
            android:textAppearance="@style/TextAppearance.FocusLife.Body"
            android:textColor="@color/text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_sleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/mode_sleep"
            android:textAppearance="@style/TextAppearance.FocusLife.Body"
            android:textColor="@color/text_primary" />

        <!-- ============ Always ============ -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_always"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:minHeight="@dimen/touch_target"
            android:text="@string/blocker_block_always"
            android:textAppearance="@style/TextAppearance.FocusLife.Body"
            android:textColor="@color/text_primary" />

        <!-- ============ Strict ============ -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_strict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/blocker_strict_mode"
            android:textAppearance="@style/TextAppearance.FocusLife.Body"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/blocker_strict_hint"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

        <!-- ============ Usage so far ============ -->
        <TextView
            android:id="@+id/tv_usage_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_pill"
            android:padding="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

    </LinearLayout>
</ScrollView>
