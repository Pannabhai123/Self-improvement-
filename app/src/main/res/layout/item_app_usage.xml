<?xml version="1.0" encoding="utf-8"?>
<!--
  One app in the most-used list.

  The bar is scaled against the heaviest app rather than a fixed maximum, so a
  day where the top app ran 20 minutes still shows meaningful proportions.
  Blocked apps are tinted differently — not red, because using an app you set a
  limit on is not a moral failure, it is the exact thing the limit exists for.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:background="@drawable/bg_pill"
    android:minHeight="@dimen/list_item_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_app_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:minWidth="22dp"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption"
            android:textColor="@color/text_tertiary"
            tools:text="1." />

        <TextView
            android:id="@+id/tv_app_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.FocusLife.Body"
            tools:text="Instagram" />

        <TextView
            android:id="@+id/tv_app_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.FocusLife.Body"
            android:textColor="@color/accent_500"
            tools:text="1 h 12 m" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_app"
        style="@style/Widget.FocusLife.ProgressHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/space_s"
        android:max="100"
        tools:progress="100" />

    <TextView
        android:id="@+id/tv_app_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.FocusLife.Caption"
        tools:text="Social · 18 openings" />
</LinearLayout>
