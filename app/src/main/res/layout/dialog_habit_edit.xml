<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xxl"
    android:paddingTop="@dimen/space_l"
    android:paddingEnd="@dimen/space_xxl"
    android:paddingBottom="@dimen/space_s">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.FocusLife.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/habits_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="60"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/habits_reminder"
        android:textAppearance="@style/TextAppearance.FocusLife.Label" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reminder_off"
            style="@style/Widget.FocusLife.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_none" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reminder_morning"
            style="@style/Widget.FocusLife.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="06:00" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reminder_evening"
            style="@style/Widget.FocusLife.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="20:00" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>
