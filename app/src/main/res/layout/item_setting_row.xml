<?xml version="1.0" encoding="utf-8"?>
<!--
  One tappable settings row: a label, its current value and a chevron. Used for
  the five daily targets, each of which opens the same number dialog.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:background="@drawable/bg_pill"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/selectable_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_item_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_l"
    android:paddingEnd="@dimen/space_m"
    android:paddingTop="@dimen/space_m"
    android:paddingBottom="@dimen/space_m">

    <TextView
        android:id="@+id/tv_setting_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.FocusLife.Body"
        tools:text="Study target" />

    <TextView
        android:id="@+id/tv_setting_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.FocusLife.Body"
        android:textColor="@color/accent_500"
        tools:text="6 h 0 m" />

    <ImageView
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_marginStart="@dimen/space_s"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_tertiary" />
</LinearLayout>
