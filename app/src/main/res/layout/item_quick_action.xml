<?xml version="1.0" encoding="utf-8"?>
<!--
  A quick-action tile. 48dp minimum height and a full-width hit area: these are
  the most-tapped controls on the home screen and are often used one-handed while
  walking, so the target is generous rather than visually tight.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FocusLife.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/selectable_row">

    <LinearLayout
        android:id="@+id/quick_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_m">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_timer"
            app:tint="@color/accent_500" />

        <TextView
            android:id="@+id/tv_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.FocusLife.Label"
            android:textColor="@color/text_primary"
            tools:text="Deep Focus" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
