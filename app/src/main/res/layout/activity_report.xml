<?xml version="1.0" encoding="utf-8"?>
<!--
  Daily and weekly report — brief section 11.

  One screen with two states rather than two screens, because the user is reading
  the same story at two zoom levels and a back-and-forth navigation would break
  the comparison. The toggle button always names the view it leads to.

  Metric rows are built in code from the same DailySummaryEntity the notification
  and the dashboard read, so the three can never disagree about a day.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/report_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_900"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_xxl"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/screen_padding">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginStart="-16dp"
            android:background="@color/navy_900"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_secondary"
            app:title="@string/title_daily_report"
            app:titleTextColor="@color/text_primary" />

        <!-- ============ Day navigation (daily view only) ============ -->
        <LinearLayout
            android:id="@+id/day_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_prev_day"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="@drawable/selectable_row"
                android:contentDescription="@string/cd_previous_day"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_day_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.FocusLife.Title"
                android:textColor="@color/text_primary"
                tools:text="Mon, 17 Nov" />

            <ImageButton
                android:id="@+id/btn_next_day"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="@drawable/selectable_row"
                android:contentDescription="@string/cd_next_day"
                android:rotation="180"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- ============ Score ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusLife.Card.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <com.focuslife.app.ui.widget.ProgressRingView
                    android:id="@+id/ring_score"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:contentDescription="@string/cd_progress_ring"
                    app:prv_strokeWidth="12dp" />

                <TextView
                    android:id="@+id/tv_score_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary"
                    tools:text="Focus score 72 · 4-day streak" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Trend (weekly view only) ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_trend"
            style="@style/Widget.FocusLife.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/report_weekly_trend" />

                <TextView
                    android:id="@+id/tv_trend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.FocusLife.Title"
                    android:textColor="@color/text_primary"
                    tools:text="Improving week on week" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Metric rows ============ -->
        <TextView
            style="@style/CardTitle"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/report_summary" />

        <LinearLayout
            android:id="@+id/metric_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <!-- ============ Charts (weekly view only) ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_charts"
            style="@style/Widget.FocusLife.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/report_score_by_day" />

                <com.focuslife.app.ui.widget.BarChartView
                    android:id="@+id/chart_scores"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height"
                    android:layout_marginTop="@dimen/space_m"
                    android:contentDescription="@string/cd_chart"
                    app:bcv_showValues="true" />

                <TextView
                    style="@style/CardTitle"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/report_study_by_day" />

                <com.focuslife.app.ui.widget.BarChartView
                    android:id="@+id/chart_study"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height"
                    android:layout_marginTop="@dimen/space_m"
                    android:contentDescription="@string/cd_chart" />

                <TextView
                    style="@style/CardTitle"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/report_habits_by_day" />

                <com.focuslife.app.ui.widget.WeekStripView
                    android:id="@+id/strip_habits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Improvement areas ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_improvement"
            style="@style/Widget.FocusLife.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/report_improvement" />

                <TextView
                    android:id="@+id/tv_improvement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:lineSpacingExtra="6dp"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary"
                    tools:text="1 h 20 m short of the study target" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_generated_at"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption"
            tools:text="Generated at 9:04 PM" />

        <!-- ============ Actions ============ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_view"
            style="@style/Widget.FocusLife.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:minHeight="@dimen/touch_target"
            android:text="@string/report_view_weekly" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share"
            style="@style/Widget.FocusLife.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:minHeight="@dimen/touch_target"
            android:text="@string/action_share"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
