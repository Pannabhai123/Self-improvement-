<?xml version="1.0" encoding="utf-8"?>
<!--
  Logging an urge.

  Kept to four short inputs. A diary that takes a minute to fill in does not get
  filled in at the moment of an urge, which is the only moment worth recording.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xxl"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/space_xxl"
        android:paddingBottom="@dimen/space_s">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/control_triggers"
            android:textAppearance="@style/TextAppearance.FocusLife.Label" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_trigger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.FocusLife.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:hint="@string/control_intended_task">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_intended_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="60"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_urge_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/control_urge_level"
            android:textAppearance="@style/TextAppearance.FocusLife.Label" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_urge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="3"
            android:valueFrom="1"
            android:valueTo="5"
            app:labelBehavior="visible" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.FocusLife.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:hint="@string/control_minutes_lost">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_minutes_lost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/control_minutes_lost_hint"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_resisted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:checked="true"
            android:minHeight="@dimen/touch_target"
            android:text="@string/control_resisted_toggle"
            android:textAppearance="@style/TextAppearance.FocusLife.Body"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/control_alternatives"
            android:textAppearance="@style/TextAppearance.FocusLife.Label" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_alternative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

    </LinearLayout>
</ScrollView>
