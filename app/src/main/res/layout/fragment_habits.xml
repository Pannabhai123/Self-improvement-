<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_900">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/habits_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_l"
            android:paddingEnd="@dimen/screen_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_habits"
                android:textAppearance="@style/TextAppearance.FocusLife.Headline" />

            <TextView
                android:id="@+id/tv_habits_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                tools:text="Monday, 17 November" />

            <!-- ============ Completion summary ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLife.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <com.focuslife.app.ui.widget.ProgressRingView
                        android:id="@+id/ring_habits"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        app:prv_animate="true"
                        app:prv_max="100"
                        app:prv_progress="0"
                        app:prv_strokeWidth="9dp"
                        app:prv_trackStrokeWidth="9dp"
                        app:prv_valueTextSize="@dimen/text_subtitle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_l"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CardTitle"
                            android:text="@string/habits_completion" />

                        <TextView
                            android:id="@+id/tv_habits_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.FocusLife.Subtitle"
                            tools:text="7 of 10" />

                        <TextView
                            android:id="@+id/tv_habits_encouragement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary"
                            tools:text="Good progress. 3 habits left — pick the easiest one." />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Weekly calendar + streak ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLife.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/habits_week_calendar" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_local_fire"
                            app:tint="@color/warning_500" />

                        <TextView
                            android:id="@+id/tv_habit_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.FocusLife.Label"
                            android:textColor="@color/text_primary"
                            tools:text="7 days" />
                    </LinearLayout>

                    <com.focuslife.app.ui.widget.WeekStripView
                        android:id="@+id/week_strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        app:wsv_cellSize="38dp" />

                    <TextView
                        android:id="@+id/tv_best_streak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                        tools:text="Best streak: 21 days" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 30-day chart ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLife.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/habits_progress_chart" />

                    <com.focuslife.app.ui.widget.BarChartView
                        android:id="@+id/chart_habits"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/chart_height"
                        android:layout_marginTop="@dimen/space_m"
                        app:bcv_highlightLast="true"
                        app:bcv_showValues="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Checklist ============ -->
            <TextView
                style="@style/CardTitle"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/habits_today" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_habits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="10"
                tools:listitem="@layout/item_habit" />

            <!-- ============ Missed-habit analysis ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLife.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/habits_analysis" />

                    <!-- The framing sentence is part of the feature, not decoration:
                         the brief asks explicitly that missing habits must not shame. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/habits_analysis_desc"
                        android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

                    <LinearLayout
                        android:id="@+id/analysis_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_habit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:text="@string/habits_add"
        android:textColor="@color/text_on_accent"
        app:backgroundTint="@color/accent_600"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/text_on_accent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
