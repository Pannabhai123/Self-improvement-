<?xml version="1.0" encoding="utf-8"?>
<!--
  Pick which apps to block.

  The search field sits above the list rather than in a collapsing app bar: on a
  720p screen a collapsing bar eats enough vertical space that the list shows
  only two or three rows, which makes the screen feel empty and slow to scan.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_900">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/navy_900"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_secondary"
            app:title="@string/title_select_apps"
            app:titleTextColor="@color/text_primary" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.FocusLife.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:hint="@string/blocker_search_hint"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/text_tertiary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- The suggested row is the brief's named apps, so the common case needs
             no searching at all. -->
        <TextView
            android:id="@+id/tv_suggested"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="@string/blocker_suggested"
            android:textAppearance="@style/TextAppearance.FocusLife.Overline" />

        <HorizontalScrollView
            android:id="@+id/suggested_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_suggested"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_selected_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption"
            tools:text="4 apps selected" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_s"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_xxl"
            android:scrollbars="vertical"
            tools:itemCount="8"
            tools:listitem="@layout/item_app_row" />

        <TextView
            android:id="@+id/tv_loading"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/blocker_loading_apps"
            android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

        <!-- The blocker cannot intercept anything without this, so the button sits
             permanently at the bottom rather than appearing only after a failure. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_accessibility_missing"
            style="@style/Widget.FocusLife.Card.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/screen_padding"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/warning_500" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:text="@string/blocker_needs_accessibility"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_enable_accessibility"
                    style="@style/Widget.FocusLife.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_grant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_selected"
            style="@style/Widget.FocusLife.Button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_margin="@dimen/screen_padding"
            android:text="@string/blocker_add_selected"
            android:textSize="@dimen/text_subtitle" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
