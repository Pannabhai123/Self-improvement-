<?xml version="1.0" encoding="utf-8"?>
<!--
  One routine slot.

  The clock time is the largest element because that is what the user scans when
  checking the shape of their day; the activity name is second. Disabled slots
  dim to 45% rather than being struck through, so they read as "not today"
  instead of "cancelled".
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/slot_card"
    style="@style/Widget.FocusLife.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/selectable_row">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="@dimen/space_m">

        <View
            android:id="@+id/slot_accent"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_rounded_small"
            android:backgroundTint="@color/accent_500" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_slot_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.FocusLife.Body"
                tools:text="Mathematics" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alarm"
                    app:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tv_slot_remind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                    tools:text="Remind 10 min before" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_slot_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.FocusLife.Title"
            android:textColor="@color/text_primary"
            tools:text="08:00" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_slot_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/touch_target"
            android:contentDescription="@string/routine_enabled" />

        <ImageButton
            android:id="@+id/btn_slot_delete"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/selectable_row"
            android:contentDescription="@string/action_delete"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_tertiary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
