<?xml version="1.0" encoding="utf-8"?>
<!-- Per-app limits, mode flags, strict mode and scheduled blocking. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/limit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_900">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/navy_900"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_secondary"
            app:title="@string/title_usage_limits"
            app:titleTextColor="@color/text_primary" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/limit_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_xxl"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <TextView
                    android:id="@+id/tv_limit_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/blocker_subtitle"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

                <!-- ============ Enforcement state ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_enforcement"
                    style="@style/Widget.FocusLife.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_enforcement_icon"
                                android:layout_width="@dimen/icon_size"
                                android:layout_height="@dimen/icon_size"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/success_500" />

                            <TextView
                                android:id="@+id/tv_enforcement_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_m"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.FocusLife.Body"
                                tools:text="Blocking is active" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_enforcement_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                            tools:text="Accessibility and overlay are both granted." />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_fix_permissions"
                            style="@style/Widget.FocusLife.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/perm_reopen_setup"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ Blocked apps ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/title_blocker" />

                    <TextView
                        android:id="@+id/tv_blocked_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                        tools:text="6 apps" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_no_blocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/blocker_no_apps"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_blocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_blocked_app" />

                <!-- ============ Schedules ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/title_schedules" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_schedule"
                        style="@style/Widget.FocusLife.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/blocker_schedule_add" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_schedule_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/blocker_schedule_hint"
                    android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

                <TextView
                    android:id="@+id/tv_no_schedules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/blocker_schedule_empty"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

                <LinearLayout
                    android:id="@+id/schedule_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="vertical" />

                <!-- ============ Add apps ============ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_apps"
                    style="@style/Widget.FocusLife.Button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/title_select_apps"
                    android:textSize="@dimen/text_subtitle"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconTint="@color/text_on_accent" />

                <TextView
                    android:id="@+id/tv_total_blocks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                    tools:text="142 blocks in total" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
