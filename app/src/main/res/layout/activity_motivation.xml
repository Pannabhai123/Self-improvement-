<?xml version="1.0" encoding="utf-8"?>
<!--
  Motivation: today's quote, personal goals, the vision board, discipline
  reminders and milestones.

  The four messages from the brief are quote_1..quote_4 and appear in the daily
  rotation; the quote shown here is the same deterministic per-day pick used on
  the dashboard, so the two screens never disagree about what today's line is.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motivation_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_900"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_xxl"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/screen_padding">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginStart="-16dp"
            android:background="@color/navy_900"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_secondary"
            app:title="@string/title_motivation"
            app:titleTextColor="@color/text_primary" />

        <!-- ============ Quote of the day ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusLife.Card.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/motivation_quote_today"
                    android:textAppearance="@style/TextAppearance.FocusLife.Overline" />

                <TextView
                    android:id="@+id/tv_quote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:lineSpacingExtra="6dp"
                    android:textAppearance="@style/TextAppearance.FocusLife.Title"
                    android:textColor="@color/text_primary"
                    tools:text="Discipline is choosing between what you want now and what you want most." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_new_quote"
                    style="@style/Widget.FocusLife.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/motivation_new_quote"
                    app:icon="@drawable/ic_sparkles"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Discipline reminder ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusLife.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/motivation_discipline_reminder" />

                <TextView
                    android:id="@+id/tv_discipline_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:lineSpacingExtra="4dp"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary"
                    tools:text="You have kept a 12-day streak. One more day is all today asks." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Vision board ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CardTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/motivation_vision_board" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_vision"
                style="@style/Widget.FocusLife.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/motivation_add_vision" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vision_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <!-- ============ Goals ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CardTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/motivation_goals" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_goal"
                style="@style/Widget.FocusLife.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/motivation_add_goal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_no_goals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/motivation_no_goals"
            android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

        <LinearLayout
            android:id="@+id/goal_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <!-- ============ Milestones ============ -->
        <TextView
            style="@style/CardTitle"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/motivation_milestones" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/motivation_milestones_desc"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

        <LinearLayout
            android:id="@+id/milestone_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_no_milestones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/motivation_milestones_empty"
            android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

        <!-- ============ Lifetime ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusLife.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/motivation_lifetime" />

                <LinearLayout
                    android:id="@+id/lifetime_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
