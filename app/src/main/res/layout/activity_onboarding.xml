<?xml version="1.0" encoding="utf-8"?>
<!--
  Permission setup, shown on first launch and reachable from Profile at any time.

  Every row states plainly what the permission is for and what stops working
  without it. Nothing is bundled, nothing is implied, and every step except
  notifications can be skipped — a skipped permission degrades one feature rather
  than blocking the app, because refusing a permission is a legitimate choice.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_900"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_xxl"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_xxl"
        android:paddingEnd="@dimen/screen_padding">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.FocusLife.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/onboarding_welcome"
            android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

        <!-- ============ Permissions ============ -->
        <TextView
            style="@style/CardTitle"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/title_permissions" />

        <LinearLayout
            android:id="@+id/permission_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <!-- ============ Privacy ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FocusLife.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/onboarding_privacy_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/onboarding_privacy_1"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/onboarding_privacy_2"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/onboarding_privacy_3"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/onboarding_privacy_4"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_permission_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption"
            tools:text="2 of 4 permissions granted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_finish"
            style="@style/Widget.FocusLife.Button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/onboarding_finish"
            android:textSize="@dimen/text_subtitle"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconTint="@color/text_on_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_skip"
            style="@style/Widget.FocusLife.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:minHeight="@dimen/touch_target"
            android:text="@string/onboarding_skip" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
