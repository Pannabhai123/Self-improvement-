<?xml version="1.0" encoding="utf-8"?>
<!--
  Manual study-log entry, for time studied away from the phone or before the
  timer existed.

  Deliberately a separate dialog from the timer: typing minutes in is a
  different act from running a clock, and merging them makes both harder to use.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xxl"
    android:paddingTop="@dimen/space_l"
    android:paddingEnd="@dimen/space_xxl"
    android:paddingBottom="@dimen/space_s">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.FocusLife.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_minutes_short">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="4"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_subject"
        style="@style/Widget.FocusLife.TextInput.ExposedDropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:hint="@string/study_subjects">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/dropdown_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/study_log_manual_hint"
        android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

</LinearLayout>
