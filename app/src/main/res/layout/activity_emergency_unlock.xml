<?xml version="1.0" encoding="utf-8"?>
<!--
  Emergency unlock: the deliberate, logged, time-boxed way past a block.

  Every element here exists to make the bypass a decision rather than a reflex:
  the count of unlocks already used today, the reason prompt, the cooldown, and
  a five-second hold instead of a tap. Nothing hides the fact that it is being
  recorded, because an unlock that pretends to be free is an unlock that gets
  used constantly.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/unlock_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_block"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_xxl"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xxl">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock_open"
            app:tint="@color/warning_500" />

        <TextView
            android:id="@+id/unlock_app_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.FocusLife.Overline"
            tools:text="YOUTUBE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/emergency_title"
            android:textAppearance="@style/TextAppearance.FocusLife.Title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_display_small" />

        <TextView
            android:id="@+id/unlock_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary"
            tools:text="You blocked YouTube yourself, at a calmer moment." />

        <!-- ============ What you get, and what it costs ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="vertical">

            <TextView
                android:id="@+id/unlock_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.FocusLife.Subtitle"
                android:textColor="@color/accent_500"
                tools:text="Unlocks for 10 minutes" />

            <TextView
                android:id="@+id/unlock_used_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                tools:text="Used 2 times today · every unlock is logged" />
        </LinearLayout>

        <!-- ============ Cooldown ============ -->
        <TextView
            android:id="@+id/cooldown_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:background="@drawable/bg_pill"
            android:padding="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary"
            android:textColor="@color/warning_500"
            android:visibility="gone"
            tools:text="An unlock was used recently. Available in 12:40."
            tools:visibility="visible" />

        <!-- ============ Reason ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/emergency_reason_prompt"
            android:textAppearance="@style/TextAppearance.FocusLife.Title" />

        <RadioGroup
            android:id="@+id/radio_reasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_work"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_s"
                android:text="@string/emergency_reason_work"
                android:textAppearance="@style/TextAppearance.FocusLife.Body"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/radio_family"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_s"
                android:text="@string/emergency_reason_family"
                android:textAppearance="@style/TextAppearance.FocusLife.Body"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/radio_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_s"
                android:text="@string/emergency_reason_other"
                android:textAppearance="@style/TextAppearance.FocusLife.Body"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/radio_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_s"
                android:text="@string/control_add_reason"
                android:textAppearance="@style/TextAppearance.FocusLife.Body"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/custom_reason_field"
            style="@style/Widget.FocusLife.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/control_reason_hint"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/custom_reason_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="200"
                android:maxLines="3"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ============ Hold to confirm ============ -->
        <TextView
            android:id="@+id/hold_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/block_cooldown_hint"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

        <TextView
            android:id="@+id/hold_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.FocusLife.Subtitle"
            android:textColor="@color/accent_500"
            tools:text="Keep holding · 3s" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hold_unlock"
            style="@style/Widget.FocusLife.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/emergency_hold_to_unlock"
            android:textColor="@color/warning_500"
            android:textSize="@dimen/text_subtitle"
            app:strokeColor="@color/warning_500" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.FocusLife.Button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/emergency_back_to_task"
            android:textSize="@dimen/text_subtitle"
            app:icon="@drawable/ic_check_circle"
            app:iconGravity="textStart"
            app:iconTint="@color/text_on_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:text="@string/block_privacy_note"
            android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

    </LinearLayout>
</ScrollView>
