<?xml version="1.0" encoding="utf-8"?>
<!--
  One habit row.

  The whole row is the tap target, not just the checkbox: a 30dp checkbox is below
  the 48dp minimum and habit ticking happens repeatedly, often one-handed.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FocusLife.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/selectable_row">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_m">

        <FrameLayout
            android:layout_width="@dimen/habit_check_size"
            android:layout_height="@dimen/habit_check_size">

            <ImageView
                android:id="@+id/iv_check_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/habit_check_bg" />

            <ImageView
                android:id="@+id/iv_check_mark"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_white"
                android:visibility="invisible"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_habit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.FocusLife.Body"
                tools:text="Study Mathematics" />

            <TextView
                android:id="@+id/tv_habit_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                tools:text="12 day streak · 48 times completed" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_habit_menu"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/selectable_row"
            android:contentDescription="@string/action_edit"
            android:src="@drawable/ic_edit"
            app:tint="@color/text_tertiary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
