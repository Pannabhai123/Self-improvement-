<?xml version="1.0" encoding="utf-8"?>
<!--
  Mobile Usage Analyzer — brief section 7.

  Everything here is derived from UsageStatsManager totals that the app itself
  snapshotted. There is no network call in the whole project and no content is
  read: only per-package foreground minutes and, where the OS exposes them,
  launch counts. The screen says so, because a usage analyzer that does not state
  its own scope invites the wrong assumption.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/usage_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_900"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_xxl"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/screen_padding">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginStart="-16dp"
            android:background="@color/navy_900"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_secondary"
            app:title="@string/title_usage"
            app:titleTextColor="@color/text_primary" />

        <!-- ============ Permission gate ============ -->
        <!--
          Shown instead of every measurement when usage access is off. The
          numbers are not faked to zero: an unmeasured day is reported as
          unmeasured, and the button leads straight to the system toggle.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_no_permission"
            style="@style/Widget.FocusLife.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <ImageView
                    android:layout_width="@dimen/icon_size_large"
                    android:layout_height="@dimen/icon_size_large"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_visibility"
                    app:tint="@color/warning_500" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/usage_no_permission"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/usage_grant_hint"
                    android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_grant_usage"
                    style="@style/Widget.FocusLife.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/action_grant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Measured content ============ -->
        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Today -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLife.Card.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/usage_screen_time_today"
                            android:textAppearance="@style/TextAppearance.FocusLife.Overline" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_refresh"
                            style="@style/Widget.FocusLife.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/usage_refresh"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="textStart" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_screen_today"
                        style="@style/MetricValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:textColor="@color/text_primary"
                        tools:text="3 h 42 m" />

                    <TextView
                        android:id="@+id/tv_screen_vs_yesterday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary"
                        tools:text="Down 25 m from yesterday — that is real progress." />

                    <TextView
                        android:id="@+id/tv_screen_limit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                        tools:text="48 m under your limit" />

                    <TextView
                        android:id="@+id/tv_last_snapshot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                        tools:text="Last updated 2:14 PM" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- App openings -->
            <include
                android:id="@+id/card_openings"
                layout="@layout/item_metric_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l" />

            <!-- Categories -->
            <TextView
                style="@style/CardTitle"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/usage_categories" />

            <LinearLayout
                android:id="@+id/category_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="vertical" />

            <!-- Blocked share -->
            <TextView
                android:id="@+id/tv_blocked_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary"
                tools:text="41 m of today's screen time was on blocked apps." />

            <!-- Most-used apps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/usage_most_used" />

                <TextView
                    android:id="@+id/tv_app_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.FocusLife.Caption"
                    tools:text="12 apps" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_no_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/usage_snapshot_empty"
                android:textAppearance="@style/TextAppearance.FocusLife.Body.Secondary" />

            <LinearLayout
                android:id="@+id/app_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="vertical" />

            <!-- Weekly comparison -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLife.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/usage_weekly_compare" />

                    <com.focuslife.app.ui.widget.BarChartView
                        android:id="@+id/chart_week"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/chart_height"
                        android:layout_marginTop="@dimen/space_m"
                        app:bcv_showValues="true" />

                    <LinearLayout
                        android:id="@+id/week_stat_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Daily limit -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FocusLife.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/usage_daily_limit" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_limit"
                            style="@style/Widget.FocusLife.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/action_edit" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_limit_value"
                        style="@style/MetricValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        tools:text="Limit: 3 h 0 m per day" />

                    <ProgressBar
                        android:id="@+id/pb_limit"
                        style="@style/Widget.FocusLife.ProgressHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="@dimen/space_s"
                        android:max="100"
                        tools:progress="72" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Suggestions -->
            <TextView
                style="@style/CardTitle"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/usage_suggestions" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/usage_suggestions_desc"
                android:textAppearance="@style/TextAppearance.FocusLife.Caption" />

            <LinearLayout
                android:id="@+id/tip_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="vertical" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
